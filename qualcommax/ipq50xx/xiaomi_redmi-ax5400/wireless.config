# AX5400 无线相关包 —— 必须显式置 =y
#
# 背景：X-WRT 官方模板里这些包全是 =m，靠
#   CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax5400
# 逐设备塞进 rootfs。而本流水线为了只编一台设备关掉了
# CONFIG_TARGET_MULTI_PROFILE，该 per-device 包列表随之失效；
# =m 的包只会产出 ipk，不会打进 sysupgrade 镜像 —— 刷完就是没 WiFi。
# 所以这里必须显式改成 =y。
#
# 注意：不要为了"还原官方包集合"改回 MULTI_PROFILE=y，
# 官方那条 per-device 列表含 openvpn / nginx / uwsgi / wireguard 等几十个包，
# 会显著拉长编译时间。这里只补无线必需项。

# cfg80211 / mac80211 / ath 通用层
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-ath=y

# IPQ5018 内置 2.4G 走 AHB，QCN9024 5G 走 PCI
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y

# QCN9074 / QCN9024 的 MHI 与 QRTR 依赖（官方设备列表里有）
CONFIG_PACKAGE_kmod-mhi-bus=y
CONFIG_PACKAGE_kmod-qrtr-mhi=y

# 固件 + 板级校准数据（BDF），缺 ipq-wifi 的话无线接口根本起不来
CONFIG_PACKAGE_ath11k-firmware-ipq5018=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=y
CONFIG_PACKAGE_ipq-wifi-xiaomi_redmi-ax5400=y

# 认证守护进程。wpad 各变体互斥，选 openssl 版与 PassWall 共用 libopenssl
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y

# LED 与温度（官方设备列表里有，ath11k 温度管理会用到）
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-thermal=y

# 诊断工具
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-tools=y
